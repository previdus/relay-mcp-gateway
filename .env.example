GATEWAY_API_KEY=replace-with-a-random-key-of-at-least-24-characters
GATEWAY_ADMIN_KEY=use-a-different-random-admin-key-of-at-least-24-characters
UPSTREAM_API_KEY=replace-with-the-upstream-credential
# Recommended for production: exact, deployment-owned outbound destination pins.
# Update this endpoint and credential reference to match gateway.config.json.
# GATEWAY_REQUIRE_CREDENTIAL_BINDINGS=true
# GATEWAY_CREDENTIAL_BINDINGS='[{"reference":"MCP_UPSTREAM_EXAMPLE","endpoint":"https://your-approved-server.example/mcp","purpose":"upstream-endpoint"},{"reference":"UPSTREAM_API_KEY","endpoint":"https://your-approved-server.example/mcp","purpose":"upstream"}]'
# Strict binding mode also pins resolved upstream addresses. Use this flag to enable egress validation separately.
# GATEWAY_REQUIRE_EGRESS_VALIDATION=true
# Private endpoints require narrow RFC1918/ULA CIDRs; link-local/metadata and other special-use ranges stay blocked.
# GATEWAY_EGRESS_ALLOWED_PRIVATE_CIDRS=10.24.0.0/16,fc00:1234::/48
PORT=3000
HOST=127.0.0.1
# Shared database enables multiple replicas. Omit for a local SQLite database.
# DATABASE_URL=postgresql://gateway:password@localhost:5432/gateway
# GATEWAY_ALLOWED_HOSTS=localhost,127.0.0.1,gateway.example.com
# UPSTREAM_ALLOWED_HOSTS=approved-mcp.example.com
# JWT_ISSUER=https://identity.example.com/
# JWT_AUDIENCE=https://gateway.example.com/mcp
# JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# GATEWAY_RESOURCE_URL=https://gateway.example.com/mcp
# JWT_REQUIRED_SCOPES=mcp:access
# JWT_REQUIRED_TYP=at+jwt
# JWT_MAX_TOKEN_AGE_SECONDS=3600
# Optional immediate JWT revocation. Requires a shared PostgreSQL store for
# replicas (SQLite is single-instance). Revocations use only issuer + signed
# jti; JWTs without a bounded jti are denied while this mode is enabled.
# JWT_REVOCATION_ENABLED=true
# Alternative for 2–16 independent trusted issuers. Each gateway client identity
# must pin its exact issuer with oauthIssuer in gateway.config.json.
# JWT_ISSUER_PROFILES='[{"issuer":"https://idp-a.example","audience":"https://gateway.example/mcp","jwksUrl":"https://idp-a.example/.well-known/jwks.json","requiredTyp":"at+jwt","requiredScopes":["mcp:access"]},{"issuer":"https://idp-b.example","audience":"https://gateway.example/mcp","jwksUrl":"https://idp-b.example/.well-known/jwks.json","requiredTyp":"at+jwt","requiredScopes":["mcp:access"]}]'
# Optional OAuth DPoP proof-of-possession enforcement (requires JWT mode).
# The public URL must be HTTPS and match the URL seen by clients; set explicitly
# when TLS terminates at a trusted ingress. PostgreSQL shares replay protection
# across replicas; the default in-memory store is suitable only for one process.
# JWT_DPOP_REQUIRED=true
# GATEWAY_DPOP_PUBLIC_ORIGIN=https://gateway.example.com
# GATEWAY_DPOP_MAX_AGE_SECONDS=60
# Optional resource-server nonce challenges reduce proof pre-generation risks.
# Set the same random secret (at least 32 characters) on every replica.
# GATEWAY_DPOP_NONCE_REQUIRED=true
# GATEWAY_DPOP_NONCE_SECRET=replace-with-a-shared-random-secret-of-at-least-32-characters
# Alternative to JWT mode: opaque OAuth bearer introspection. Do not configure both.
# OAUTH_INTROSPECTION_URL=https://identity.example.com/oauth/introspect
# OAUTH_ISSUER=https://identity.example.com/
# OAUTH_AUDIENCE=https://gateway.example.com/mcp
# OAUTH_INTROSPECTION_CLIENT_ID=relay-resource-server
# OAUTH_INTROSPECTION_CLIENT_SECRET=use-a-deployment-secret
# OAUTH_REQUIRED_SCOPES=mcp:access
# OAUTH_MAX_TOKEN_AGE_SECONDS=3600
# Optional OAuth DPoP enforcement (requires introspection mode).
# OAUTH_DPOP_REQUIRED=true
# Alternative certificate-only agent authentication: configure all three TLS files.
# The gateway terminates HTTPS, requests a client certificate, validates it against
# the CA file, then maps the DER SHA-256 base64url thumbprint in client config.
# No bearer token fallback is accepted in mTLS mode. Use secrets mounts for files.
# GATEWAY_TLS_CERT_FILE=/run/secrets/gateway-cert.pem
# GATEWAY_TLS_KEY_FILE=/run/secrets/gateway-key.pem
# GATEWAY_MTLS_CLIENT_CA_FILE=/run/secrets/agent-client-ca.pem
# FGA_URL=https://openfga.example.com
# FGA_STORE_ID=your-store-id
# FGA_MODEL_ID=your-immutable-model-id
# FGA_API_TOKEN=your-openfga-service-token
# New multi-tenant deployments: provision matching v2 tuples before enabling.
# FGA_NAMESPACE_FORMAT=tuple-v2
# Optional Open Policy Agent decision API; composes with allowlist, roles and OpenFGA.
# OPA_DECISION_URL=https://opa.example.com/v1/data/mcp/authz/allow
# OPA_BEARER_TOKEN=deployment-secret-for-opa
# OPA_TIMEOUT_MS=1000
# OPA_ALLOW_LOCAL_HTTP=true

# Optional out-of-process router. The service may return only a target already
# present in the enabled, tenant/selector-eligible gateway route pool.
# ROUTER_DECISION_URL=https://router.example.com/decide
# ROUTER_BEARER_TOKEN=deployment-secret-for-router
# ROUTER_TIMEOUT_MS=500
# ROUTER_ALLOW_LOCAL_HTTP=true

# Optional remote inspection. Its service receives full tool arguments and
# results; approve its data region, access, and retention before enabling.
# INSPECTOR_DECISION_URL=https://inspection.example.com/decide
# INSPECTOR_BEARER_TOKEN=deployment-secret-for-inspection
# Required exact names or namespace wildcard, e.g. alpha__echo,finance__*
# INSPECTOR_TOOLS=alpha__echo
# INSPECTOR_TIMEOUT_MS=1000
# INSPECTOR_MAX_BYTES=262144
# The remote inspector receives only id and tenantId by default. Add fields explicitly if required.
# INSPECTOR_IDENTITY_FIELDS=id,tenantId
# Metadata-only by default. Set to full only after approving transfer of tool arguments and results.
# INSPECTOR_DATA_MODE=full
# INSPECTOR_ALLOW_LOCAL_HTTP=true

# Optional external human-approval workflow for selected tools. Add
# "approvalRequiredTools": ["payments__transfer"] to gateway.config.json.
# The approval service receives the full arguments and caller/route/contract
# binding; its operator owns reviewer authentication, durable state, expiry,
# and atomic one-use permit consumption.
# APPROVAL_DECISION_URL=https://approval.example.com/decide
# APPROVAL_BEARER_TOKEN=deployment-secret-for-approval
# APPROVAL_TIMEOUT_MS=1000
# APPROVAL_MAX_BYTES=262144
# APPROVAL_ALLOW_LOCAL_HTTP=true

# Required when features.callbacks or features.tasks is enabled; identical on every replica.
# GATEWAY_STATE_KEY=generate-a-separate-random-32-byte-or-longer-secret
# Optional stdio executable allowlist, separated by semicolons; absolute paths only.
# STDIO_ALLOWED_COMMANDS=/usr/local/bin/approved-mcp-server

# Optional OTLP/HTTP tracing (include /v1/traces path for your collector).
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# OTEL_SERVICE_NAME=relay-gateway
# OTEL_TRACES_SAMPLE_RATIO=0.1
# OTEL_ALLOW_LOCAL_HTTP=true
